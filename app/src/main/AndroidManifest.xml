<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground service permission for timer -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Notification permission for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibration for completion alerts -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- DeepMinute Application -->
    <application
        android:name=".AndroidNativeBaseApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeepMinute.Starting"
        tools:targetApi="31">

        <!-- Launcher Activity with Splash Theme -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DeepMinute.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pomodoro Timer Foreground Service -->
        <service
            android:name="vn.start.pomodoro.service.PomodoroForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Pomodoro Notification Action Receiver -->
        <receiver
            android:name="vn.start.pomodoro.service.PomodoroActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="vn.start.pomodoro.ACTION_PAUSE" />
                <action android:name="vn.start.pomodoro.ACTION_RESUME" />
                <action android:name="vn.start.pomodoro.ACTION_STOP" />
            </intent-filter>
        </receiver>

    </application>

</manifest>